# Newsboat — integrado ao Omarchy
# Cores usam a paleta ANSI do terminal, então seguem o tema do Omarchy
# automaticamente (omarchy theme set ... já re-tema o foot/kitty).

# --- Atualização -------------------------------------------------------------
auto-reload yes
reload-time 30
reload-threads 8
max-items 300
cleanup-on-quit yes
show-read-feeds no
confirm-mark-feed-read no

# --- Integração com o desktop ------------------------------------------------
# Links abrem no navegador padrão do Omarchy (omarchy default browser ...)
browser "omarchy-launch-browser %u >/dev/null 2>&1 &"
# Notificação no shell do Omarchy quando chegam itens novos
notify-program "notify-send"
notify-format "Newsboat: %d novos artigos (%n não lidos)"
notify-always no
# Macros (tecla , + letra)
macro v set browser "setsid -f mpv --really-quiet %u >/dev/null 2>&1" ; open-in-browser ; set browser "omarchy-launch-browser %u >/dev/null 2>&1 &"
macro y set browser "printf %s %u | wl-copy" ; open-in-browser ; set browser "omarchy-launch-browser %u >/dev/null 2>&1 &"

# --- Teclas estilo vim -------------------------------------------------------
bind-key j down
bind-key k up
bind-key J next-feed articlelist
bind-key K prev-feed articlelist
bind-key g home
bind-key G end
bind-key ^D pagedown
bind-key ^U pageup
bind-key l open
bind-key h quit
bind-key o open-in-browser-and-mark-read
bind-key n next-unread
bind-key N prev-unread
bind-key D pb-download
bind-key x pb-delete
bind-key a toggle-article-read

# --- Aparência ---------------------------------------------------------------
text-width 90
feedlist-format "%4i %n %11u  %t"
articlelist-format "%4i %f %D  %?T?│%-17T│ &?%t"
datetime-format "%d/%m %H:%M"
feedlist-title-format "Feeds  %u não lidos · %t total"
articlelist-title-format "%T  (%u não lidos)"

color background          default default
color listnormal          default default
color listnormal_unread   blue    default bold
color listfocus           black   yellow
color listfocus_unread    black   yellow  bold
color info                black   blue    bold
color article             default default
color title               yellow  default bold

highlight article "^(Feed|Title|Author|Link|Date):.*" cyan default
highlight article "^(Title):.*" yellow default bold
highlight article "https?://[^ ]+" green default underline
highlight article "\\[[0-9]+\\]" magenta default bold
highlight article "\\[image [0-9]+\\]" magenta default
highlight feedlist "^─.*$" magenta default bold
